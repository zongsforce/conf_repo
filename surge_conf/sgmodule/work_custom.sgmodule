#!name=Work Custom
#!desc=工作配置
#!category=conf

[General]
#skip-proxy = %APPEND% *.byted.org, *bytedance.net
#always-raw-tcp-hosts = *.byted.org

[Rule]
RULE-SET,providers/ByteDance.list,FLOW

# === 公司终端安全与接入软件：始终直连 ===
PROCESS-NAME,"/Applications/Microsoft Defender.app/",FLOW
PROCESS-NAME,/Applications/CorpLink.app/,FLOW
PROCESS-NAME,/Library/CorpLink/,FLOW
PROCESS-NAME,/usr/local/corplink/,FLOW
DOMAIN-SUFFIX,endpoint.security.microsoft.com,FLOW

# === Devbox ===
SRC-IP,10.37.62.70,PROXY,"notification-text=\"devbox 场景\"","notification-interval=60"
SRC-IP,10.37.73.194,PROXY,"notification-text=\"devbox2 场景\"","notification-interval=60"
SRC-IP,10.37.103.156,PROXY,"notification-text=\"devbox3 场景\"","notification-interval=60"
SRC-IP,10.37.103.158,PROXY,"notification-text=\"devbox4 场景\"","notification-interval=60"
SRC-IP,10.37.96.33,PROXY,"notification-text=\"devbox5 场景\"","notification-interval=60"
SRC-IP,10.37.103.186,PROXY,"notification-text=\"devbox6 场景\"","notification-interval=60"

[Host]
*.byted.org = server:system
*.bytedance.net = server:system
